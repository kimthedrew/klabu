{
  "name": "klabu-backend",
  "version": "1.0.0",
  "description": "Backend for Klabu food delivery platform",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:generate": "prisma generate",
